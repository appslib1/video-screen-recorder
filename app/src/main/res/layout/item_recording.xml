<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="2dp"
    android:clickable="true"
    android:focusable="true">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/thumb"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:background="?attr/colorSurfaceVariant"
        android:foreground="?attr/selectableItemBackground"
        android:importantForAccessibility="no"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Thumb"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintDimensionRatio="4:5"/>

    <View
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_thumb_gradient"
        app:layout_constraintStart_toStartOf="@id/thumb"
        app:layout_constraintEnd_toEndOf="@id/thumb"
        app:layout_constraintBottom_toBottomOf="@id/thumb"/>

    <TextView
        android:id="@+id/duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.02"
        android:fontFeatureSettings="tnum"
        android:shadowColor="#99000000"
        android:shadowRadius="4"
        android:shadowDx="0"
        android:shadowDy="1"
        app:layout_constraintEnd_toEndOf="@id/thumb"
        app:layout_constraintBottom_toBottomOf="@id/thumb"
        tools:text="01:23"/>
</androidx.constraintlayout.widget.ConstraintLayout>
