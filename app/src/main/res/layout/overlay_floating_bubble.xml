<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bubbleRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_bubble_pill"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp"
    android:elevation="8dp">

    <View
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/bg_bubble"
        android:layout_marginEnd="8dp"/>

    <TextView
        android:id="@+id/bubbleTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorOnSurface"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginEnd="8dp"
        tools:text="00:12"/>

    <ImageView
        android:id="@+id/bubblePause"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:padding="4dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/bg_bubble"
        android:src="@drawable/ic_pause"
        android:contentDescription="@string/bubble_pause_cd"/>

    <ImageView
        android:id="@+id/bubbleStop"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:padding="4dp"
        android:background="@drawable/bg_bubble"
        android:src="@drawable/ic_stop"
        android:contentDescription="@string/bubble_stop_cd"/>
</LinearLayout>
