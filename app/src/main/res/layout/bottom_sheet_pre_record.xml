<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_xl"
    android:paddingTop="@dimen/space_sm"
    android:paddingBottom="@dimen/space_2xl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="@dimen/space_sm">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pre_title"
                android:textAppearance="@style/TextAppearance.App.Title"
                android:textColor="?attr/colorOnSurface"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/pre_subtitle_v2"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"/>
        </LinearLayout>

        <ImageButton
            android:id="@+id/settingsShortcut"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_settings"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/library_settings_cd"
            app:tint="?attr/colorOnSurface"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_summary_card"
        android:layout_marginTop="@dimen/space_lg"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingVertical="@dimen/space_sm">

        <LinearLayout
            android:id="@+id/rowAudio"
            style="@style/SummaryRow"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">
            <ImageView style="@style/SummaryIcon" android:src="@drawable/ic_mic"/>
            <TextView style="@style/SummaryLabel" android:text="@string/pre_audio_label"/>
            <TextView style="@style/SummaryValue" android:id="@+id/sumAudio" tools:text="Mic"/>
        </LinearLayout>

        <View style="@style/SummaryDivider"/>

        <LinearLayout
            android:id="@+id/rowQuality"
            style="@style/SummaryRow"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">
            <ImageView style="@style/SummaryIcon" android:src="@drawable/ic_hd"/>
            <TextView style="@style/SummaryLabel" android:text="@string/setting_quality_title"/>
            <TextView style="@style/SummaryValue" android:id="@+id/sumQuality" tools:text="High · 1080p"/>
        </LinearLayout>

        <View style="@style/SummaryDivider"/>

        <LinearLayout
            android:id="@+id/rowCountdown"
            style="@style/SummaryRow"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">
            <ImageView style="@style/SummaryIcon" android:src="@drawable/ic_timer"/>
            <TextView style="@style/SummaryLabel" android:text="@string/setting_countdown_title"/>
            <TextView style="@style/SummaryValue" android:id="@+id/sumCountdown" tools:text="3 s"/>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2xl"
        android:paddingHorizontal="2dp"
        android:paddingBottom="12dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/startBtn"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:background="@drawable/bg_start_button"
            android:text="@string/pre_start_v2"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:letterSpacing="0.03"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:elevation="14dp"
            android:outlineAmbientShadowColor="#FF4D4F"
            android:outlineSpotShadowColor="#FF4D4F"
            app:icon="@drawable/ic_record_ring"
            app:iconGravity="textStart"
            app:iconSize="30dp"
            app:iconTint="@color/white"
            app:iconPadding="14dp"
            app:cornerRadius="24dp"
            app:backgroundTint="@null"
            app:rippleColor="#44FFFFFF"
            tools:ignore="UnusedAttribute"/>
    </FrameLayout>
</LinearLayout>
