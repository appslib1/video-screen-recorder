<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="24dp"/>
                    <gradient
                        android:type="linear"
                        android:angle="135"
                        android:startColor="#FF6B6E"
                        android:centerColor="#FF4D4F"
                        android:endColor="#E63E40"/>
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="24dp"/>
                    <gradient
                        android:type="linear"
                        android:angle="270"
                        android:startColor="#30FFFFFF"
                        android:endColor="#00FFFFFF"/>
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
